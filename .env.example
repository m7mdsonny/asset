# GACMS – مثال متغيرات البيئة (انسخ إلى .env وعدّل القيم)
# Copy to .env and set values for your environment

# التطبيق
APP_NAME=GACMS
DEBUG=false
ENVIRONMENT=development

# قاعدة البيانات (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://gacms:YOUR_PASSWORD@localhost:5432/gacms

# JWT (غيّر SECRET_KEY في الإنتاج إلى قيمة عشوائية 32 حرفاً على الأقل)
SECRET_KEY=change-me-in-production-min-32-characters-required
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# روابط المسح والـ QR (للتطوير المحلي استخدم http؛ في الإنتاج استخدم https)
SCAN_BASE_URL=http://localhost:8000
QR_SIGNING_SECRET=qr-signing-secret-change-in-production

# المجلدات
UPLOAD_DIR=./uploads
PDF_OUTPUT_DIR=./generated_pdfs
BACKUP_DIR=./backups

# CORS (أصول مسموح بها، مفصولة بفاصلة)
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
