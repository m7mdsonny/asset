# GACMS Environment Configuration
# Copy to .env and fill values

# App
APP_NAME=GACMS
DEBUG=false
ENVIRONMENT=development

# Database
   DATABASE_URL=postgresql+asyncpg://postgres:mypass@localhost:5432/gacms
# JWT
SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# QR & Scan
SCAN_BASE_URL=https://your-domain.com
QR_SIGNING_SECRET=qr-signing-secret-change-in-production

# Storage (PDFs, signed copies)
UPLOAD_DIR=./uploads
PDF_OUTPUT_DIR=./generated_pdfs

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
